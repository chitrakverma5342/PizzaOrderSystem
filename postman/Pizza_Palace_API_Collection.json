    {
      "name": "04 - Orders & Checkout",
      "item": [
        {
          "name": "POST /api/orders — Place Valid Order (With Coupon & Variable Chaining)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "pm.test('Order created with accurate discount & totals', function () {",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.have.property('id');",
                  "    pm.expect(json.data.customer_name).to.eql('Alex Morgan');",
                  "    pm.expect(json.data.customer_email).to.eql('student@univ.edu');",
                  "    pm.expect(json.data.status).to.eql('pending');",
                  "    // 10.99 (Pepperoni) + 4.49 (Garlic Bread) = 15.48 subtotal",
                  "    pm.expect(json.data.total_price).to.eql(15.48);",
                  "    // 10% discount on 15.48 = 1.55",
                  "    pm.expect(json.data.discount).to.eql(1.55);",
                  "    // 15.48 - 1.55 = 13.93 final",
                  "    pm.expect(json.data.final_price).to.eql(13.93);",
                  "});",
                  "",
                  "// Variable Chaining: Save created order ID for subsequent GET & PATCH tests",
                  "pm.environment.set('createdOrderId', json.data.id);",
                  "console.log('Saved createdOrderId to environment:', json.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"customer_name\": \"Alex Morgan\",\n    \"customer_email\": \"student@univ.edu\",\n    \"phone\": \"+1 (555) 234-5678\",\n    \"address\": \"742 Evergreen Terrace, Apt 4B\",\n    \"items\": [\n        { \"id\": 2, \"name\": \"Pepperoni\", \"price\": 10.99, \"quantity\": 1 },\n        { \"id\": 6, \"name\": \"Garlic Bread\", \"price\": 4.49, \"quantity\": 1 }\n    ],\n    \"coupon_code\": \"WELCOME10\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            }
          }
        },
