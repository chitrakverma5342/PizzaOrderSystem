{
  "name": "pizza-order-system",
  "version": "1.0.0",
  "description": "Pizza Ordering System — University Software Testing Project",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "npx nodemon src/server.js",
    "test": "jest --verbose",
    "test:coverage": "jest --coverage --verbose",
    "test:api": "newman run postman/Pizza_Palace_API_Collection.json -e postman/Pizza_Palace_Local_Environment.json --reporters cli",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "keywords": ["pizza", "ordering", "testing", "stlc"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "sql.js": "^1.10.3",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "jest": "^29.7.0",
    "newman": "^6.1.2",
    "nodemon": "^3.0.2"
  }
}
